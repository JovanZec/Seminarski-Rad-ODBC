@model StudentViewModel
@{ ViewData["Title"] = "Dodavanje studenta"; }
<h1>Dodavanje studenta</h1>
<p class="text-muted">Podaci prolaze kroz MVC → BLL → DAL → ODBC → bazu.</p>
<form asp-action="Create" method="post" class="card card-body shadow-sm mt-3">
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Sačuvaj</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Odustani</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

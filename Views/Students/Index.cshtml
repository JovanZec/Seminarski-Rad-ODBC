@model IReadOnlyList<StudentViewModel>
@{
    ViewData["Title"] = "Evidencija studenata";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Evidencija studenata</h1>
        <p class="text-muted mb-0">Podaci se čitaju iz SQL Server baze preko ODBC drajvera.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Dodaj studenta</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Ime i prezime</th><th>Indeks</th><th>Email</th><th>Godina</th><th></th></tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center py-4 text-muted">Nema unetih studenata.</td></tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FirstName @item.LastName</td>
                        <td><span class="badge text-bg-secondary">@item.IndexNumber</span></td>
                        <td>@item.Email</td>
                        <td>@item.StudyYear</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detalji</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Izmeni</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Obriši</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
